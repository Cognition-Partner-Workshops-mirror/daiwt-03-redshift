# Redshift source operator
REDSHIFT_HOST=your-workgroup.012345678901.us-east-1.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_USER=your-admin-user
REDSHIFT_PASSWORD=your-admin-password
REDSHIFT_DATABASE=daiwt_03_retail
REDSHIFT_ADMIN_DATABASE=dev
REDSHIFT_WORKGROUP=daiwt-03-retail
REDSHIFT_SECRET=daiwt-03-redshift-connection
AWS_REGION=us-east-1

# Optional external reconciliation connection
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_CONFIG_PROFILE=DEFAULT
DATABRICKS_WAREHOUSE_ID=your-warehouse-id
MIG_CATALOG=daiwt_03
